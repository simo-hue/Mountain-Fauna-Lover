# Public canonical URL used for metadata and structured data.
# No trailing slash.
#
# ⚠️  This localhost value is for LOCAL DEVELOPMENT ONLY. It must be overridden in
# the Vercel project settings (Production environment) with the real origin:
#
#     NEXT_PUBLIC_SITE_URL=https://mountain-fauna-lover.vercel.app
#
# If it is left as localhost in production, every canonical, hreflang alternate,
# og:image, sitemap entry and JSON-LD @id points at a non-resolvable address.
# src/config/site.ts now refuses a loopback origin in production builds and falls
# back to the real host, but the environment variable should still be set correctly.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional. Leave empty to disable Google Analytics.
NEXT_PUBLIC_GA_ID=

# Required for live collaboration email delivery.
# Get a free API key at https://resend.com
RESEND_API_KEY=
# Without a verified domain, use onboarding@resend.dev as the sender.
# With a verified domain, use: Your Name <contact@yourdomain.com>
CONTACT_FROM_EMAIL=onboarding@resend.dev
# Must match your Resend account email when no custom domain is verified.
CONTACT_TO_EMAIL=deerfaunalover@gmail.com
